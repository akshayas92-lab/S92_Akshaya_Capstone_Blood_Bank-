tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  # Update Blood Request
  
  Updates a blood request. Requires authentication.
  
  ## Authentication
  Requires JWT token in Authorization header
  
  ## Path Parameters
  - `id` (string, required): Blood request's MongoDB ID
  
  ## Request Body (any of the following)
  - `donor` (string): ID of assigned donor
  - `status` (string): Status (pending, fulfilled, cancelled)
  - `urgency` (string): Urgency level (low, medium, high, critical)
  
  ## Response
  Updated blood request object
  
  ## Status Codes
  - 200: Success
  - 400: Invalid input or ID
  - 401: Missing or invalid token
  - 404: Request not found
  - 500: Server error
}
