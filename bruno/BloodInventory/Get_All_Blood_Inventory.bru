meta {
  name: Get All Blood Inventory
  type: http
  seq: 2
}

get {
  url: http://localhost:5000/api/blood-inventory
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  # Get All Blood Inventory
  
  Retrieves all blood inventory records. Requires authentication.
  
  ## Authentication
  Requires JWT token in Authorization header
  
  ## Response
  Array of blood inventory objects containing:
  - `_id`: Unique inventory ID
  - `bloodGroup`: Blood group
  - `unitsAvailable`: Available units
  - `lastUpdated`: Last update timestamp
  
  ## Status Codes
  - 200: Success
  - 401: Missing or invalid token
  - 500: Server error
}
